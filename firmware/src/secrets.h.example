#pragma once

// 模板文件：复制成 secrets.h 后按需填写
//   cp src/secrets.h.example src/secrets.h
//
// WiFi 凭据、SERVER_URL、API_TOKEN 都可通过手机配网页写入 NVS，
// 不必再改这里重烧。这里只作为「首次打开配网页」时的默认值。

// 可选：预填到配网页（留空则完全靠手机配置）
#define WIFI_SSID     ""
#define WIFI_PASSWORD ""

// 配网页里「Server URL / API Token」的初始默认值
#define SERVER_URL    "http://192.168.1.100:8787/metrics"
#define API_TOKEN     ""
